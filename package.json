{
  "name": "repo-search-workshop",
  "version": "1.0.0",
  "private": true,
  "description": "A local TypeScript investigation exercise for Map First, Read Less",
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "workspaces": ["packages/*"],
  "scripts": {
    "demo": "node apps/demo.ts",
    "test:repro": "node --test --test-name-pattern=\"^maxRetries: 0 makes one attempt$\" packages/client/test/client.test.ts",
    "test": "node --test packages/*/test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.0",
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  }
}
